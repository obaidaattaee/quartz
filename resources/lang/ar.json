    "services.development.problem.description": "\u0646\u0627\u062f\u0631\u0627\u064b \u0645\u0627 \u062a\u0644\u0628\u064a \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0627\u0644\u062c\u0627\u0647\u0632\u0629 \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0627\u0644\u0641\u0631\u064a\u062f\u0629. \u062a\u0639\u0627\u0646\u064a \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0645\u0646 \u0623\u0646\u0638\u0645\u0629 \u062c\u0627\u0645\u062f\u0629 \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0648\u0633\u064a\u0639\u0647\u0627\u060c \u0648\u0636\u0639\u0641 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0628\u064a\u0646 \u0627\u0644\u0623\u062f\u0648\u0627\u062a\u060c \u0648\u062a\u0631\u0627\u0643\u0645 \u0627\u0644\u062f\u064a\u0648\u0646 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u0628\u0637\u0626 \u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631.",
