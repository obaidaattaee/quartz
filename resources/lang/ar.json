    "contact.subtitle": "\u0644\u062f\u064a\u0643 \u0645\u0634\u0631\u0648\u0639 \u0641\u064a \u0628\u0627\u0644\u0643\u061f \u062f\u0639\u0646\u0627 \u0646\u062a\u062d\u062f\u062b \u0639\u0646 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u0646\u0627 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629.",
