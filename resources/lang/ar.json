    "services.development.deliverables.1": "\u062a\u0635\u0645\u064a\u0645 \u0648\u062a\u0643\u0627\u0645\u0644 \u0648\u0627\u062c\u0647\u0627\u062a API",
    "services.development.deliverables.2": "\u0647\u0646\u062f\u0633\u0629 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u062d\u0633\u064a\u0646\u0647\u0627",
