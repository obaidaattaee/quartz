    "services.automation.hero.title": "\u0627\u0644\u0623\u062a\u0645\u062a\u0629",
    "services.automation.hero.subtitle": "\u062a\u062e\u0644\u0651\u0635 \u0645\u0646 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u062a\u0643\u0631\u0631 \u0648\u0623\u0637\u0644\u0642 \u0627\u0644\u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0639\u0628\u0631 \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0627\u0644\u0630\u0643\u064a\u0629",
    "services.automation.problem.title": "\u0627\u0644\u062a\u062d\u062f\u064a",
    "services.automation.problem.description": "\u062a\u0633\u062a\u0646\u0632\u0641 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u064a\u062f\u0648\u064a\u0629 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0648\u062a\u064f\u062f\u062e\u0644 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0648\u062a\u0645\u0646\u0639 \u0627\u0644\u0641\u0631\u0642 \u0645\u0646 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0644 \u0639\u0627\u0644\u064a \u0627\u0644\u0642\u064a\u0645\u0629. \u0645\u0639 \u0646\u0645\u0648 \u0627\u0644\u0623\u0639\u0645\u0627\u0644\u060c \u062a\u062a\u0636\u0627\u0639\u0641 \u0647\u0630\u0647 \u0627\u0644\u0625\u0634\u0643\u0627\u0644\u064a\u0627\u062a \u0628\u0634\u0643\u0644 \u0623\u0633\u064a\u0651.",
    "services.automation.approach.title": "\u0646\u0647\u062c\u0646\u0627",
    "services.automation.approach.description": "\u0646\u062d\u062f\u062f \u0641\u0631\u0635 \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0639\u0628\u0631 \u0639\u0645\u0644\u064a\u0627\u062a\u0643 \u0648\u0646\u0646\u0641\u0630 \u062d\u0644\u0648\u0644\u0627\u064b \u062a\u062d\u0642\u0642 \u0639\u0627\u0626\u062f\u0627\u064b \u0645\u0644\u0645\u0648\u0633\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631.",
    "services.automation.step1.title": "\u0627\u0644\u062a\u062f\u0642\u064a\u0642",
    "services.automation.step1.description": "\u0631\u0633\u0645 \u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0648\u062a\u062d\u062f\u064a\u062f \u0641\u0631\u0635 \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062a\u0623\u062b\u064a\u0631",
    "services.automation.step2.title": "\u0627\u0644\u062a\u0635\u0645\u064a\u0645",
    "services.automation.step2.description": "\u0625\u0646\u0634\u0627\u0621 \u0645\u062e\u0637\u0637\u0627\u062a \u0623\u062a\u0645\u062a\u0629 \u0648\u0627\u0636\u062d\u0629 \u0645\u0639 \u0645\u0639\u0627\u064a\u064a\u0631 \u0646\u062c\u0627\u062d \u0648\u062e\u0637\u0637 \u062a\u0631\u0627\u062c\u0639",
    "services.automation.step3.title": "\u0627\u0644\u062a\u0646\u0641\u064a\u0630",
    "services.automation.step3.description": "\u0628\u0646\u0627\u0621 \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0633\u064a\u0631 \u0639\u0645\u0644 \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0645\u0639 \u0628\u062f\u064a\u0644 \u064a\u062f\u0648\u064a \u0645\u0648\u0627\u0632\u064d",
    "services.automation.step4.title": "\u0627\u0644\u062a\u062d\u0633\u064a\u0646",
    "services.automation.step4.description": "\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0623\u062f\u0627\u0621 \u0648\u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0645\u0634\u063a\u0651\u0644\u0627\u062a \u0648\u062a\u0648\u0633\u064a\u0639 \u0646\u0637\u0627\u0642 \u0627\u0644\u0623\u062a\u0645\u062a\u0629",
    "services.automation.deliverables.title": "\u0645\u0627 \u062a\u062d\u0635\u0644 \u0639\u0644\u064a\u0647",
    "services.automation.deliverables.0": "\u062a\u0635\u0645\u064a\u0645 \u0648\u062a\u0646\u0641\u064a\u0630 \u0623\u062a\u0645\u062a\u0629 \u0633\u064a\u0631 \u0627\u0644\u0639\u0645\u0644",
    "services.automation.deliverables.1": "\u062d\u0644\u0648\u0644 RPA (\u0623\u062a\u0645\u062a\u0629 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0631\u0648\u0628\u0648\u062a\u064a\u0629)",
    "services.automation.deliverables.2": "\u062a\u0643\u0627\u0645\u0644 \u0628\u064a\u0646 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629",
    "services.automation.deliverables.3": "\u0644\u0648\u062d\u0627\u062a \u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0622\u0644\u064a\u0629",
    "services.automation.deliverables.4": "\u062a\u062f\u0631\u064a\u0628 \u0627\u0644\u0641\u0631\u064a\u0642 \u0648\u0627\u0644\u062a\u0648\u062b\u064a\u0642",
    "services.automation.cta": "\u0623\u062a\u0645\u062a \u0633\u064a\u0631 \u0639\u0645\u0644\u0643",

    "services.qa.hero.title": "\u0636\u0645\u0627\u0646 \u0627\u0644\u062c\u0648\u062f\u0629",
    "services.qa.hero.subtitle": "\u0642\u062f\u0651\u0645 \u0628\u0631\u0645\u062c\u064a\u0627\u062a \u062e\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0628\u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0627\u062a \u0627\u062e\u062a\u0628\u0627\u0631 \u0634\u0627\u0645\u0644\u0629 \u062a\u0643\u0634\u0641 \u0627\u0644\u0645\u0634\u0627\u0643\u0644 \u0642\u0628\u0644 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0643",
    "services.qa.problem.title": "\u0627\u0644\u062a\u062d\u062f\u064a",
    "services.qa.problem.description": "\u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0641\u064a \u0628\u064a\u0626\u0629 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u062a\u0636\u0631 \u0628\u0627\u0644\u062b\u0642\u0629 \u0648\u0627\u0644\u0625\u064a\u0631\u0627\u062f\u0627\u062a. \u0628\u062f\u0648\u0646 \u0627\u062e\u062a\u0628\u0627\u0631 \u0645\u0646\u0647\u062c\u064a\u060c \u062a\u0637\u0644\u0642 \u0627\u0644\u0641\u0631\u0642 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0639\u0644\u0649 \u0623\u0645\u0644 \u0627\u0644\u0623\u0641\u0636\u0644 \u0628\u064a\u0646\u0645\u0627 \u062a\u062a\u0631\u0627\u0643\u0645 \u0627\u0644\u062f\u064a\u0648\u0646 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0648\u0645\u0634\u0627\u0643\u0644 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0628\u0635\u0645\u062a.",
    "services.qa.approach.title": "\u0646\u0647\u062c\u0646\u0627",
    "services.qa.approach.description": "\u0646\u062f\u0645\u062c \u0627\u0644\u062c\u0648\u062f\u0629 \u0641\u064a \u062c\u0645\u064a\u0639 \u0645\u0631\u0627\u062d\u0644 \u062f\u0648\u0631\u0629 \u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u0628\u0645\u0632\u064a\u062c \u0645\u0646 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u0622\u0644\u064a\u0629 \u0648\u0627\u0644\u064a\u062f\u0648\u064a\u0629 \u0627\u0644\u0645\u0635\u0645\u0651\u0645\u0629 \u0644\u0648\u062a\u064a\u0631\u0629 \u0625\u0635\u062f\u0627\u0631\u0627\u062a\u0643.",
    "services.qa.step1.title": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645",
    "services.qa.step1.description": "\u062a\u0642\u064a\u064a\u0645 \u0646\u0636\u062c \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0648\u062a\u062d\u062f\u064a\u062f \u0641\u062c\u0648\u0627\u062a \u0627\u0644\u062a\u063a\u0637\u064a\u0629 \u0627\u0644\u062d\u0631\u062c\u0629",
    "services.qa.step2.title": "\u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629",
    "services.qa.step2.description": "\u062a\u0635\u0645\u064a\u0645 \u0647\u0631\u0645 \u0627\u062e\u062a\u0628\u0627\u0631: \u0648\u062d\u062f\u0627\u062a\u060c \u062a\u0643\u0627\u0645\u0644\u060c \u0634\u0627\u0645\u0644\u060c \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0633\u062a\u0643\u0634\u0627\u0641\u064a",
    "services.qa.step3.title": "\u0627\u0644\u062a\u0646\u0641\u064a\u0630",
    "services.qa.step3.description": "\u0628\u0646\u0627\u0621 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631 \u0648\u0623\u062a\u0645\u062a\u0629 \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0648\u062f\u0645\u062c\u0647\u0627 \u0641\u064a CI/CD",
    "services.qa.step4.title": "\u062c\u0648\u062f\u0629 \u0645\u0633\u062a\u0645\u0631\u0629",
    "services.qa.step4.description": "\u0635\u064a\u0627\u0646\u0629 \u0645\u0633\u062a\u0645\u0631\u0629 \u0644\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0623\u062f\u0627\u0621 \u0648\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u062c\u0648\u062f\u0629",
    "services.qa.deliverables.title": "\u0645\u0627 \u062a\u062d\u0635\u0644 \u0639\u0644\u064a\u0647",
    "services.qa.deliverables.0": "\u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629 \u0648\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a",
    "services.qa.deliverables.1": "\u062a\u0637\u0648\u064a\u0631 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u062e\u062a\u0628\u0627\u0631 \u0622\u0644\u064a\u0629",
    "services.qa.deliverables.2": "\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0623\u062f\u0627\u0621 \u0648\u0627\u0644\u062d\u0645\u0644",
    "services.qa.deliverables.3": "\u0641\u062d\u0635 \u0627\u0644\u062b\u063a\u0631\u0627\u062a \u0627\u0644\u0623\u0645\u0646\u064a\u0629",
    "services.qa.deliverables.4": "\u0645\u0642\u0627\u064a\u064a\u0633 \u0648\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u062c\u0648\u062f\u0629",
    "services.qa.cta": "\u062d\u0633\u0651\u0646 \u062c\u0648\u062f\u062a\u0643",

    "services.cybersecurity.hero.title": "\u0627\u0644\u0623\u0645\u0646 \u0627\u0644\u0633\u064a\u0628\u0631\u0627\u0646\u064a",
    "services.cybersecurity.hero.subtitle": "\u0627\u062d\u0645\u0650 \u0645\u0624\u0633\u0633\u062a\u0643 \u0628\u0623\u0645\u0627\u0646 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0645\u0624\u0633\u0633\u0627\u062a \u064a\u0633\u0628\u0642 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u0637\u0648\u0631\u0629",
    "services.cybersecurity.problem.title": "\u0627\u0644\u062a\u062d\u062f\u064a",
    "services.cybersecurity.problem.description": "\u062a\u0632\u062f\u0627\u062f \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0627\u0644\u0633\u064a\u0628\u0631\u0627\u0646\u064a\u0629 \u062a\u0639\u0642\u064a\u062f\u0627\u064b \u064a\u0648\u0645\u064a\u0627\u064b. \u0628\u062f\u0648\u0646 \u0645\u0648\u0642\u0641 \u0623\u0645\u0646\u064a \u0627\u0633\u062a\u0628\u0627\u0642\u064a\u060c \u062a\u0648\u0627\u062c\u0647 \u0627\u0644\u0645\u0624\u0633\u0633\u0627\u062a \u0627\u062e\u062a\u0631\u0627\u0642\u0627\u062a \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0625\u062e\u0641\u0627\u0642\u0627\u062a \u0641\u064a \u0627\u0644\u0627\u0645\u062a\u062b\u0627\u0644 \u0648\u0623\u0636\u0631\u0627\u0631 \u0633\u0645\u0639\u0629 \u0642\u062f \u062a\u0633\u062a\u063a\u0631\u0642 \u0633\u0646\u0648\u0627\u062a \u0644\u0644\u062a\u0639\u0627\u0641\u064a \u0645\u0646\u0647\u0627.",
    "services.cybersecurity.approach.title": "\u0646\u0647\u062c\u0646\u0627",
    "services.cybersecurity.approach.description": "\u0646\u062a\u0628\u0639 \u0646\u0647\u062c \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062a\u0639\u0645\u0642\u060c \u0628\u0637\u0628\u0642\u0627\u062a \u0623\u0645\u0646\u064a\u0629 \u0639\u0628\u0631 \u0628\u0646\u064a\u062a\u0643 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0648\u062a\u0637\u0628\u064a\u0642\u0627\u062a\u0643 \u0648\u0639\u0645\u0644\u064a\u0627\u062a\u0643.",
    "services.cybersecurity.step1.title": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645",
    "services.cybersecurity.step1.description": "\u062a\u062f\u0642\u064a\u0642 \u0623\u0645\u0646\u064a \u0634\u0627\u0645\u0644 \u0644\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0648\u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0648\u0627\u0644\u0633\u064a\u0627\u0633\u0627\u062a",
    "services.cybersecurity.step2.title": "\u0627\u0644\u062a\u0642\u0648\u064a\u0629",
    "services.cybersecurity.step2.description": "\u062a\u0637\u0628\u064a\u0642 \u0636\u0648\u0627\u0628\u0637 \u0627\u0644\u0623\u0645\u0627\u0646 \u0648\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062b\u063a\u0631\u0627\u062a \u0648\u062a\u0643\u0648\u064a\u0646 \u0627\u0644\u062f\u0641\u0627\u0639\u0627\u062a",
    "services.cybersecurity.step3.title": "\u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629",
    "services.cybersecurity.step3.description": "\u0646\u0634\u0631 \u0643\u0634\u0641 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0648\u062a\u0643\u0627\u0645\u0644 SIEM \u0648\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0644\u0644\u062d\u0648\u0627\u062f\u062b",
    "services.cybersecurity.step4.title": "\u0627\u0644\u0645\u0631\u0648\u0646\u0629",
    "services.cybersecurity.step4.description": "\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u062e\u062a\u0631\u0627\u0642 \u062f\u0648\u0631\u064a \u0648\u062a\u062f\u0631\u064a\u0628 \u0623\u0645\u0646\u064a \u0648\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u062a\u0639\u0627\u0641\u064a \u0645\u0646 \u0627\u0644\u0643\u0648\u0627\u0631\u062b",
    "services.cybersecurity.deliverables.title": "\u0645\u0627 \u062a\u062d\u0635\u0644 \u0639\u0644\u064a\u0647",
    "services.cybersecurity.deliverables.0": "\u062a\u0642\u064a\u064a\u0645 \u0623\u0645\u0646\u064a \u0648\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u062e\u0627\u0637\u0631",
    "services.cybersecurity.deliverables.1": "\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0627\u062e\u062a\u0631\u0627\u0642 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062b\u063a\u0631\u0627\u062a",
    "services.cybersecurity.deliverables.2": "\u0647\u0646\u062f\u0633\u0629 \u0648\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0623\u0645\u0627\u0646",
    "services.cybersecurity.deliverables.3": "\u0627\u0644\u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0644\u0644\u0627\u0645\u062a\u062b\u0627\u0644 (ISO 27001\u060c SOC 2)",
    "services.cybersecurity.deliverables.4": "\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0644\u0644\u062d\u0648\u0627\u062f\u062b",
