    "services.development.step2.title": "\u0627\u0644\u0647\u0646\u062f\u0633\u0629 \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a\u0629",
    "services.development.step2.description": "\u062a\u0635\u0645\u064a\u0645 \u0628\u0646\u064a\u0629 \u0646\u0638\u0627\u0645 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0648\u0633\u0639 \u0648\u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0645\u0639 \u0627\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629",
    "services.development.step3.title": "\u0627\u0644\u062a\u0637\u0648\u064a\u0631",
    "services.development.step3.description": "\u0633\u0628\u0631\u0646\u062a\u0627\u062a \u0631\u0634\u064a\u0642\u0629 \u0645\u0639 \u062a\u0633\u0644\u064a\u0645 \u0645\u0633\u062a\u0645\u0631 \u0648\u0645\u062a\u0627\u0628\u0639\u0629 \u0634\u0641\u0627\u0641\u0629 \u0644\u0644\u062a\u0642\u062f\u0645",
    "services.development.step4.title": "\u0627\u0644\u0625\u0637\u0644\u0627\u0642 \u0648\u0627\u0644\u062f\u0639\u0645",
    "services.development.step4.description": "\u0646\u0634\u0631 \u0633\u0644\u0633 \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0645\u0633\u062a\u0645\u0631\u0629 \u0648\u0635\u064a\u0627\u0646\u0629 \u062f\u0627\u0626\u0645\u0629 \u0644\u0636\u0645\u0627\u0646 \u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629 \u0627\u0644\u0639\u0645\u0644",
